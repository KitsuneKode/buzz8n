{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "esnext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["apps/server/src/*"],
      "@apps/web/*": ["apps/web/*"],
      "@apps/server/*": ["apps/server/*"],
      "@apps/worker/*": ["apps/worker/*"],
      "@packages/backend-common/*": ["packages/backend-common/*"],
      "@packages/common/*": ["packages/common/*"],
      "@packages/store/*": ["packages/store/*"],
      "@buzz8n/web/*": ["apps/web/*"],
      "@buzz8n/web/app/*": ["apps/web/app/*"],
      "@buzz8n/server/*": ["apps/server/src/*"],
      "@buzz8n/worker/*": ["apps/worker/src/*"],
      "@buzz8n/backend-common": ["packages/backend-common/src/index.ts"],
      "@buzz8n/backend-common/*": ["packages/backend-common/src/*"],
      "@buzz8n/common": ["packages/common/src/index.ts"],
      "@buzz8n/common/*": ["packages/common/src/*"],
      "@buzz8n/store": ["packages/store/src/index.ts"],
      "@buzz8n/store/*": ["packages/store/src/*"],
      "@buzz8n/ui/*": ["packages/ui/src/*"]
    },
    "types": ["bun"],
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
