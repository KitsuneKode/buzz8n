{
  "name": "@buzz8n/server",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify --sourcemap",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run dist/index.js"
  },
  "devDependencies": {
    "@buzz8n/typescript-config": "*",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@buzz8n/backend-common": "*",
    "@buzz8n/common": "*",
    "@buzz8n/store": "*",
    "@types/cookie-parser": "^1.4.9",
    "@types/jsonwebtoken": "^9.0.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.-1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "zod": "^4.1.11"
  }
}
