{
  "name": "@buzz8n/worker",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify --sourcemap --production",
    "check-types": "tsc --noEmit",
    "dev": "bun run --watch src/index.ts",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:fix": "tsc --noEmit && eslint \"src/**/*.ts*\" --max-warnings 0 --fix",
    "start": "bun run dist/index.js",
    "start:migrate": "bun run scripts/entrypoint.ts"
  },
  "dependencies": {
    "@buzz8n/backend-common": "*",
    "@buzz8n/common": "*",
    "@buzz8n/store": "*",
    "@langchain/anthropic": "^1.3.25",
    "@langchain/core": "^1.1.36",
    "@langchain/google-genai": "^1.0.0",
    "@langchain/langgraph": "^1.2.6",
    "@langchain/openai": "^1.3.1",
    "axios": "^1.14.0",
    "langchain": "^1.2.37",
    "mustache": "^4.2.0",
    "resend": "^6.9.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@buzz8n/eslint-config": "*",
    "@buzz8n/typescript-config": "*",
    "@types/bun": "latest",
    "@types/mustache": "^4.2.6",
    "eslint": "^9.39.4"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
