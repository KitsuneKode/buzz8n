{
  "name": "@buzz8n/store",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "bun run prisma/seed.ts",
    "check-types": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts*\" --max-warnings 0 ",
    "lint:fix": "tsc --noEmit && eslint \"src/**/*.ts*\" --max-warnings 0 --fix"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@buzz8n/typescript-config": "*",
    "@buzz8n/eslint-config": "*",
    "eslint": "^9.34.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "prisma": "^6.16.2"
  }
}
