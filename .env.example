# Shared
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/buzz8n
REDIS_URL=redis://localhost:6379

# Auth / crypto
JWT_SECRET=change-me-to-a-long-random-string
# Prefer 64-char hex (32 bytes) or base64 of 32 bytes. Other strings are SHA-256 hashed.
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server / WS
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
# Cookie domain: leave empty in local; set in prod
COOKIE_DOMAIN=localhost

# Web (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WEBHOOK_URL=http://localhost:8080/webhook/
NEXT_PUBLIC_WS_URL=ws://localhost:8082

# Optional
# JWT_EXPIRES_IN=7d
# When Redis rate-limit checks fail: true (default) allows traffic; false returns 429
# RATE_LIMIT_FAIL_OPEN=true
# Temporary migration escape hatch for unencrypted credentials (default: reject)
# ALLOW_PLAINTEXT_CREDENTIALS=false
# DAG_MAX_CONCURRENCY=4
# LOG_LEVEL=debug
