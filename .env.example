# buzz8n environment template
# Copy to apps/server/.env, apps/worker/.env, apps/ws-server/.env, and apps/web/.env.local as needed.
# Never commit real secrets. Generate keys with: openssl rand -hex 32

# Shared
NODE_ENV=development
# Set a Postgres URL for local development (do not commit real credentials)
DATABASE_URL=
REDIS_URL=

# Auth / cookies (server + ws-server)
# REQUIRED — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Production cookie domain (use localhost in development)
COOKIE_DOMAIN=localhost

# Credential encryption (server + worker) — 32-byte key as 64 hex chars
# REQUIRED — generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# Server
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# WebSocket server
# PORT=8082

# Web (Next.js public)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WEBHOOK_URL=http://localhost:8080/webhook/
NEXT_PUBLIC_WS_URL=ws://localhost:8082
